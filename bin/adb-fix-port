#!/data/data/com.termux/files/usr/bin/sh
# adb-fix-port — stable adb-over-tcp (Android 11+, no root). Discovery via mDNS
# (_adb-tls-connect._tcp), the same mechanism Shizuku uses. No setprop (Android 16
# SELinux blocks it from uid 2000), no brute-force. Then `adb tcpip PORT` + verify.
PORT="${1:-5588}"
HELPER="$(dirname "$0")/adb-mdns-port.py"
adb start-server >/dev/null 2>&1
if adb -s "localhost:$PORT" shell true >/dev/null 2>&1; then
  echo "Already on localhost:$PORT ($(adb -s localhost:$PORT shell getprop ro.product.model | tr -d "\r"))"; exit 0
fi
echo "Discovering wireless-debugging port via mDNS..."
TPORT=$(python "$HELPER" 2>/dev/null)
[ -z "$TPORT" ] && { echo "ERROR: no _adb-tls-connect mDNS service. Wireless Debugging on & paired?" >&2; exit 1; }
echo "  found adbd TLS on port $TPORT"
adb connect "localhost:$TPORT" >/dev/null 2>&1; sleep 1
adb devices | grep -q "localhost:$TPORT[[:space:]]*device" || { echo "ERROR: connect failed (paired?)" >&2; exit 1; }
adb -s "localhost:$TPORT" tcpip "$PORT"; sleep 3
adb connect "localhost:$PORT" >/dev/null 2>&1; sleep 1; adb reconnect offline >/dev/null 2>&1
adb -s "localhost:$PORT" shell true >/dev/null 2>&1 \
  && echo "OK — adb on localhost:$PORT ($(adb -s localhost:$PORT shell getprop ro.product.model | tr -d "\r"))" \
  || { echo "ERROR: verify localhost:$PORT failed" >&2; exit 1; }
